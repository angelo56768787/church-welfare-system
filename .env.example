# MongoDB Atlas connection string (free M0 cluster)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/church-welfare?retryWrites=true&w=majority
# Long random string (32+ chars): openssl rand -hex 32
JWT_SECRET=
# First admin, created by `npm run seed:admin`
ADMIN_USERNAME=admin
# Quote the value if it contains #
ADMIN_PASSWORD=""
ADMIN_NAME=مدير النظام
# Local-only: set to 1 to run against an in-memory MongoDB (no Atlas needed)
USE_MEMORY_DB=
